[MAIN]

[MESSAGES CONTROL]
# Disable specific warnings (codes adapted to current pylint).
disable=C0114,C0115,C0116,C0117,C0103,C0303,W0107,W0611,W0621,W0622,W0703,W0718,R0801,R0902,R0903,R0911,R0913,R0914,R0915,R0917

[REPORTS]
output-format=text

[BASIC]
good-names=i,j,k,ex,Run,_,id

[FORMAT]
max-line-length=120
max-module-lines=1000
indent-string='    '

[SIMILARITIES]
min-similarity-lines=4
ignore-imports=yes
